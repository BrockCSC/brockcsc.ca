# Public site URL for this deployment (used for canonical links, OG tags, and
# as the OIDC redirect_uri base). e.g. https://brockcsc.129-153-49-190.sslip.io
NEXT_PUBLIC_BASE_URL=

# --- api service ---
# Postgres connection string for the api container.
DATABASE_URL=

# Keycloak realm used for admin auth (dedicated 'brockcsc' realm, separate
# from the wayfarerbx realm).
KEYCLOAK_ISSUER=https://auth.wayfarerbx.com/realms/brockcsc
KEYCLOAK_CLIENT_ID=brockcsc-web
KEYCLOAK_CLIENT_SECRET=
# Realm role required to reach /admin.
ADMIN_ROLE=brockcsc-admin

# Secret used to sign our own session cookie (not the Keycloak token).
SESSION_JWT_SECRET=

# Same value as NEXT_PUBLIC_BASE_URL; used server-side to build the OIDC
# redirect_uri and post-login redirect.
PUBLIC_URL=

# Internal Docker DNS address of the api container, used by Next.js server
# components (which have no browser origin to resolve relative /api/... against).
API_INTERNAL_URL=http://api:3001
